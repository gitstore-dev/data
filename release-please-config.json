      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        {
          "type": "json",
          "path": "datasets/definitions.json",
          "jsonpath": "$.dataset_version"
        },
        {
          "type": "json",
          "path": "datasets/selections.lock.json",
          "jsonpath": "$.dataset_version"
        }
      ],
      "initial-version": "0.1.0"
    }
  }
}
